# 複製為 .env 後填入。切勿提交真實金鑰。
# Spec §13.1：Provider API key 只能存在 server-side。

# --- Database（docker-compose 預設值）---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=remockable
DB_USER=remockable
DB_PASSWORD=remockable

# --- Server ---
SERVER_PORT=8081
LOG_LEVEL=INFO

# --- Model providers ---
LLM_API_KEY=
STT_API_KEY=
